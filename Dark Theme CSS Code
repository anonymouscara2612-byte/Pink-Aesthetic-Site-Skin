.splash .favorite li:nth-of-type(2n+2) a:hover {
  background: #171717;
  color: #B68496 !important;
}

.splash .favorite li:nth-of-type(2n+1) a:hover::before,
.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " 🌟 ";
  color: transparent !important;
  text-shadow: 0 0 0 #B68496;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 80px;
  height: 80px;
  background-image: url("https://64.media.tumblr.com/6c80fec97a6125ff5e98357bf2e573e8/037a728724b56c3e-21/s1280x1920/f4efcb2df16460eea5ecbe247af8d7d2a1f02c50.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " ⋆⁺₊⋆☾⋆⁺₊⋆✧⋆⁺₊⋆☾⋆⁺₊⋆ ";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: #171717;
  text-align: center;
  font-size: 12px;
  color: #CCC2C7;
  opacity: 1;
  white-space: pre;
  border-radius: 10px;
}

