  text-shadow: 0 0 0 #E3B3C8;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 80px;
  height: 80px;
  background-image: url("https://64.media.tumblr.com/6c80fec97a6125ff5e98357bf2e573e8/e30c73cb659a7482-32/s1280x1920/228a83e08eab843cfcca3dda2ad5cab2fc5ffe61.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " ⋆⁺₊⋆☾⋆⁺₊⋆✧⋆⁺₊⋆☾⋆⁺₊⋆ ";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: #E3B3C8;
  text-align: center;
  font-size: 12px;
  color: #441031;
